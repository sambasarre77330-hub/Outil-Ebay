{
  "manifest_version": 3,
  "name": "EBX.COMMAND - Stock Scanner & eBay Auto-Pilot",
  "version": "3.0",
  "description": "Détecte les produits exacts, vérifie le stock en temps réel sur Amazon/AliExpress et publie sur eBay.fr.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ebay.fr/*",
        "https://*.ebay.com/*",
        "https://*.amazon.fr/*",
        "https://*.aliexpress.com/*",
        "https://*.cdiscount.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}